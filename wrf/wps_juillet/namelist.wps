&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2024-06-28_00:00:00','2024-06-28_00:00:00','2024-06-28_00:00:00',
 end_date   = '2024-08-01_00:00:00','2024-08-01_00:00:00','2024-08-01_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = '../wps/',
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  38,  28,
 j_parent_start    =   1,  38,  28,
 e_we              = 100,  76,  61,
 e_sn              = 100,  76,  61,
 geog_data_res = 'lowres', 'modis_30s_lake+30s+gmted2010_30s+lowres', 'modis_30s_lake+30s+gmted2010_30s+lowres',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   =  49.2326,
 ref_lon   =   4.0522,
 truelat1  =  45.0,
 truelat2  =  52.0,
 stand_lon =   4.0522,
 geog_data_path = 'CHEMIN/VERS/WPS_GEOG'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = '../intermediaire/ERA5',   ! fichiers intermédiaires écrits par era5_to_int_zone.py (ungrib inutile)
 opt_output_from_metgrid_path = '../met_em_juillet/',
 io_form_metgrid = 2,
 opt_metgrid_tbl_path = '../wps/metgrid/',
/
