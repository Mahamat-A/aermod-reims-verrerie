; MMIF 4.1.1 : WRF (domaine d03, 1 km) -> AERMOD, maille de la cheminée O-I, janvier 2024
; Heures en heure locale standard (UTC+1), convention « heure de fin » comme AERMET/AERMOD.
start      2024 07 01 01
stop       2024 08 01 00
TimeZone   1

; Nébulosité : fraction nuageuse calculée par WRF
CLOUDCOVER WRF

; Mode AERMET (recommandé par le guide EPA MMIF) : MMIF fournit un « site » prognostique,
; AERMET (pathway PROG, version >= 21112) recalcule u*, L et les hauteurs de mélange.
aer_mixht     AERMET
aer_min_mixht 1.0
aer_min_obuk  1.0
aer_min_speed 0.0
aer_use_NEW   T

; Maille de la cheminée A (49.2326 N, 4.0522 E), UTC+1
POINT  LL  49.2326  4.0522  1
AER_layers  1  4
Output aermet  useful  oi_juillet.useful.txt
Output aermet  onsite  oi_juillet.dat
Output aermet  BAT     oi_juillet.bat
Output aermet  aersfc  oi_juillet.aersfc.dat

; Mode AERMOD direct (sans AERMET), pour comparaison
POINT  LL  49.2326  4.0522  1
AER_layers  0  0
Output aermod  useful  oi_juillet_direct.info.txt
Output aermod  sfc     oi_juillet_direct.sfc
Output aermod  PFL     oi_juillet_direct.pfl

; Fichiers WRF du domaine d03 (ajoutés par le script une fois WRF terminé)
INPUT ../../run_juillet/wrfout_d03_2024-06-30_00:00:00
INPUT ../../run_juillet/wrfout_d03_2024-07-01_00:00:00
INPUT ../../run_juillet/wrfout_d03_2024-07-02_00:00:00
